# Drex (decision model) — console key
NACE_API_KEY=nace_sk_...
DREX_BASE_URL=https://console.nace.ai
DREX_MODEL=drex-latest

# NDI (document intelligence)
NDI_API_KEY=ndi_sk_...
NDI_BASE_URL=https://ndi-api.nace.ai

# Behavior
BUY_THRESHOLD=0.6
CONSIDER_THRESHOLD=0.35
LOW_CONFIDENCE=0.6
DREX_CONCURRENCY=8
MOCK_DREX=true
MOCK_NDI=false

# Optional: path to the MarketTwin data pack (default: ../../MarketTwin_Hackathon_Data_Pack)
# DATA_PACK_DIR=
